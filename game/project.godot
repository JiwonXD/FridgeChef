; Engine configuration file.
config_version=5

[application]

config/name="냉털 셰프"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="FridgeChef"
boot_splash/bg_color=Color(0.141, 0.129, 0.114, 1)
boot_splash/show_image=false

[autoload]

D="*res://scripts/data.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

timers/tooltip_delay_sec=0.15

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.141, 0.129, 0.114, 1)
textures/canvas_textures/default_texture_filter=1
